includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - src
        - routes
        - database
        - tests
    excludePaths:
        # Pest binds $this in test closures at runtime via uses(), which PHPStan
        # cannot model. The TestCase and Fixtures under tests/ are still analysed.
        - tests/Pest.php
        - tests/*Test.php
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
